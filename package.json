{
  "name": "logiflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:math": "esbuild scripts/verify-math.mts --bundle --platform=node --format=esm --target=node20 --alias:@=./src --packages=external --outfile=tmp-verify/math.mjs --log-level=warning && node tmp-verify/math.mjs",
    "verify:schema": "esbuild scripts/verify-document-schema.mts --bundle --platform=node --format=esm --target=node20 --alias:@=./src --packages=external --outfile=tmp-verify/schema.mjs --log-level=warning && node tmp-verify/schema.mjs",
    "verify:form": "esbuild scripts/verify-form-submission.mts --bundle --platform=node --format=esm --target=node20 --alias:@=./src --packages=external --outfile=tmp-verify/form.mjs --log-level=warning && node tmp-verify/form.mjs",
    "verify:payload": "esbuild scripts/verify-payload.mts --bundle --platform=node --format=esm --target=node20 --alias:@=./src --packages=external --outfile=tmp-verify/payload.mjs --log-level=warning && node tmp-verify/payload.mjs",
    "verify:pdf": "esbuild scripts/smoke-pdf.mts --bundle --platform=node --format=esm --target=node20 --alias:@=./src --packages=external --outfile=tmp-verify/smoke.mjs --log-level=warning && node tmp-verify/smoke.mjs && node scripts/verify-pdf.mjs tmp-verify",
    "verify:fonts": "esbuild scripts/verify-fonts.tsx --bundle --platform=node --format=esm --target=node20 --alias:@=./src --packages=external --outfile=tmp-verify/fonts.mjs --log-level=warning && node tmp-verify/fonts.mjs",
    "verify": "npm run typecheck && npm run lint && npm run verify:theme && npm run verify:math && npm run verify:schema && npm run verify:form && npm run verify:payload && npm run verify:fonts && npm run verify:pdf"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
